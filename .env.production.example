# Production environment. Copy to `.env.production`, fill in every value, and
# keep it out of version control (.gitignore already covers .env*).
#
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d

# ---- Site -------------------------------------------------------------------
# The public origin, used for canonical URLs, the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://staging.example.ch
# What Caddy answers on. Use a staging hostname until you intend to replace the
# client's existing site.
SITE_ADDRESS=staging.example.ch

# ---- Database ---------------------------------------------------------------
# Used by the postgres container and to compose DATABASE_URL for the app.
POSTGRES_USER=fiduvia
POSTGRES_PASSWORD=change-me-to-a-long-random-secret
POSTGRES_DB=fiduvia

# ---- Email (transactional: OTP codes, notifications, contact form) ----------
# Every login requires an emailed code, so if SMTP is wrong nobody can sign in.
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Fiduvia <no-reply@example.ch>"
# Where the marketing and portal contact forms deliver.
CONTACT_EMAIL=contact@example.ch

# ---- Object storage (client documents) --------------------------------------
# S3-compatible; Infomaniak Public Cloud in production, MinIO in development.
STORAGE_ENDPOINT=https://s3.pub1.infomaniak.cloud
STORAGE_BUCKET=fiduvia-documents
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=pub1
